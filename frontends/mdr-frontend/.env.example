# Build-time variables for the MDR frontend (Vite inlines VITE_* at `npm run build`).
# Copy to `.env` for local work; on Vercel set the same names under Project > Settings > Environment Variables.
# The Docker image writes this file from build args (see Dockerfile); the AWS deploy writes it in
# .github/workflows/lif_mdr_frontend.yml. Keep the three in step.

# MDR API base URL (no trailing slash). Local compose: http://localhost:8012; AWS: https://mdr-api.<env>.<domain>.
# On Vercel use the same-origin proxy path `/api` instead: vercel.json rewrites /api/* to the dev MDR API, so the
# browser never makes a cross-origin call and the API's CORS allow-list does not need the Vercel domain.
VITE_API_URL=http://localhost:8012

# Learner Data Export API, used by the Export Playground page. Leave empty if no LDE is deployed
# (the page then reports missing data formats). Local compose: http://localhost:8013; on Vercel `/lde` (proxied).
VITE_LDE_API_URL=http://localhost:8013

# Cognito hosted-UI domain and SPA app client id. Leave BOTH empty to disable Cognito and use the
# legacy username/password login. When set, the app client must list
#   <your origin>/auth/callback  as a callback URL and  <your origin>/login  as a sign-out URL.
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=

# Google Analytics measurement id (optional).
VITE_GA_MEASUREMENT_ID=
