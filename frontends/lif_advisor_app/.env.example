# Build-time variables for the Advisor app (Vite inlines VITE_* at `npm run build`).
# Copy to `.env` for local work; on Vercel set the same names under Project > Settings > Environment Variables.
# The Docker image writes this file from build args (see Dockerfile). Keep the two in step.

# Advisor REST API base URL (no trailing slash). Local compose: http://localhost:8004
VITE_LIF_ADVISOR_API_URL=http://localhost:8004

# Google Analytics measurement id (optional).
VITE_GA_MEASUREMENT_ID=
